# oldman_agent — .env.example
#
# 사용법:
#   1. 이 파일을 .env로 복사:    cp .env.example .env
#   2. 필요한 변수만 주석 해제 + 실제 값 입력
#   3. .env는 .gitignore에 등록되어 있어 커밋되지 않음
#
# 우선순위: shell export > .env 파일 > 코드 기본값
# (.env는 load_dotenv(override=False)로 로드되므로 이미 설정된 env가 우선)

# ─── LLM providers ─────────────────────────────────────────────────────────
# config/llm.yaml의 각 tier (cheap / expensive / judge)에서 provider를
# anthropic 또는 openrouter로 지정한 경우에만 해당 키가 필요합니다.
# 둘 다 미설정이면 bootstrap이 MockProvider로 폴백합니다 (publish는 영향 없음).

# Anthropic native API key.
# https://console.anthropic.com/ 에서 발급. 가격: Haiku $0.80/$4.00 per 1M tok.
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API key (Anthropic 모델을 OpenRouter 경유로 호출).
# https://openrouter.ai/keys 에서 발급. config/llm.yaml에서 provider: openrouter 선택 시 필요.
# OPENROUTER_API_KEY=sk-or-...

# ─── Runtime knobs (모두 옵션, 기본값 충분) ───────────────────────────────
# DuckDB 단일 파일 경로. 기본: ./oldman.duckdb (gitignored).
# Docker 사용 시: /data/oldman.duckdb (compose 볼륨 마운트).
# OLDMAN_DB_PATH=./oldman.duckdb

# Jaccard near-dup 스캔 윈도우 (source_agent별 최근 N개 이벤트 비교). 기본 50.
# OLDMAN_JACCARD_WINDOW=50

# Jaccard 유사도 임계값 — 이 값 이상이면 deduplicated 반환. 기본 0.9.
# OLDMAN_JACCARD_THRESHOLD=0.9

# Narrative 톤 토글: neutral (기본) | kkondae (1인칭 노년 화자).
# OLDMAN_PERSONA=neutral
